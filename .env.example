# Credenciales de WhatsApp Business Platform (Meta Cloud API).
# Mientras estas variables no estén configuradas en Vercel, los avisos de
# pedidos y reservas sólo quedan registrados en los logs de la función
# api/notify.js — el sitio funciona igual sin ellas.

# Token de acceso de la app de Meta (System User token, de larga duración).
WHATSAPP_ACCESS_TOKEN=

# ID del número de teléfono dado de alta en WhatsApp Business Platform
# (el que envía los mensajes, no el del dueño).
WHATSAPP_PHONE_NUMBER_ID=

# Número de WhatsApp del dueño que recibe los avisos y desde el que
# responde (ok/listo/en camino, confirmada/cancelada, no hay X), en
# formato internacional sin "+" ni espacios (ej: 59899123456).
OWNER_WHATSAPP_NUMBER=

# Nombre de la plantilla aprobada en Meta para todos estos mensajes
# (avisos al dueño y al cliente). Debe tener un único parámetro de
# cuerpo ({{1}}) que recibe todo el texto armado.
# Opcional: si no se define, se usa "notificacion_arrecife".
WHATSAPP_TEMPLATE_NAME=

# Token elegido por vos para verificar el webhook al configurarlo en el
# panel de Meta (cualquier string secreto que inventes).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Credenciales de Upstash Redis (Vercel Marketplace > Storage > Redis),
# para guardar el número de cada pedido/reserva y qué platos están sin
# stock. Sin esto, todo funciona en memoria y no persiste entre
# invocaciones de la función serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
