# Credenciales de WhatsApp Business Platform (Meta Cloud API).
# Mientras estas variables no estén configuradas en Vercel, los avisos de
# pedidos y reservas sólo quedan registrados en los logs de la función
# api/notify.js — el sitio funciona igual sin ellas (y le muestra al
# cliente un botón de respaldo para mandar el pedido por wa.me).

# Token de acceso de la app de Meta (System User token, de larga duración).
WHATSAPP_ACCESS_TOKEN=

# ID del número de teléfono dado de alta en WhatsApp Business Platform
# (el que envía los mensajes, no el del dueño).
WHATSAPP_PHONE_NUMBER_ID=

# Número de WhatsApp del dueño que recibe los avisos y desde el que
# responde (ok/listo/en camino, confirmada/cancelada, no hay X), en
# formato internacional sin "+" ni espacios (ej: 59899123456).
OWNER_WHATSAPP_NUMBER=

# Nombre de la plantilla aprobada en Meta. Debe tener UN solo parámetro
# de cuerpo y el parámetro no puede llevar saltos de línea (regla de
# Meta), por eso el cuerpo sugerido es:  "Aviso de Arrecife: {{1}}"
# Opcional: si no se define, se usa "notificacion_arrecife".
WHATSAPP_TEMPLATE_NAME=

# Token secreto que inventás vos para el webhook. IMPORTANTE: la
# Callback URL en el panel de Meta se configura CON el token en la query:
#   https://tu-proyecto.vercel.app/api/webhook?token=EL_MISMO_TOKEN
# Sirve para el handshake inicial (GET) y para autenticar cada mensaje
# entrante (POST).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# App Secret de la app de Meta (Configuración > Básica). Opcional pero
# recomendado: permite verificar la firma criptográfica de cada mensaje
# entrante (X-Hub-Signature-256).
META_APP_SECRET=

# Credenciales de Upstash Redis (Vercel Marketplace > Storage > Redis),
# para guardar el número de cada pedido/reserva, los platos sin stock y
# los límites anti-spam. Sin esto, todo funciona en memoria y no
# persiste entre invocaciones de la función serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
