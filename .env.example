# La app no manda ni recibe mensajes: guarda el pedido en Notion y dispara
# una automatización en n8n, que es la que se encarga de avisarle al dueño.

# --- Notion (fuente de verdad del pedido) ---------------------------------
# Si estas dos no están configuradas, /api/orders responde 502 y el cliente
# ve "no pudimos guardar tu pedido": es a propósito, preferible a confirmarle
# un pedido que no quedó en ningún lado.

# Token de una internal integration creada en
# https://www.notion.so/my-integrations  (empieza con "ntn_").
NOTION_TOKEN=

# Los 32 caracteres de la URL de la base:
#   notion.so/<workspace>/<NOTION_DATABASE_ID>?v=...
# IMPORTANTE: además hay que agregar la integración a la base desde
# ··· > Connections, o la API responde 404 aunque el token sea válido.
NOTION_DATABASE_ID=

# Opcional. Versión de la API de Notion; por defecto 2022-06-28, que es
# donde el parent de una página se declara como database_id.
NOTION_VERSION=

# --- n8n (automatización: avisarle al dueño, etc.) ------------------------
# Opcional: sin esto el pedido igual se guarda en Notion, sólo que no se
# dispara ninguna automatización.

# URL del webhook de producción del workflow de PEDIDOS.
N8N_WEBHOOK_URL=

# URL del webhook de producción del workflow de RESERVAS. Acá no es
# opcional: n8n es el único que escribe la reserva en Notion, así que sin
# esto el formulario de reservas devuelve error.
N8N_RESERVAS_WEBHOOK_URL=

# Secreto que inventás vos. Se manda en el header X-Arrecife-Secret y el
# workflow de n8n tiene que verificarlo: el webhook es una URL pública y
# sin esto cualquiera podría dispararle pedidos falsos al dueño.
N8N_SECRET=

# --- Upstash Redis (numeración diaria + rate limit) -----------------------
# Se carga solo al conectar Storage > Redis desde el Marketplace de Vercel.
# Sin esto todo funciona en memoria: el número de pedido se reinicia en cada
# invocación de la función y el límite anti-spam pasa a ser por instancia.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
